FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

ENV PYTHONUNBUFFERED=1
ENV UV_COMPILE_BYTECODE=1
ENV UV_LINK_MODE=copy

WORKDIR /app

COPY web/token-api/pyproject.toml web/token-api/uv.lock ./
RUN uv sync --locked --no-dev

COPY src/token_server.py ./token_server.py

EXPOSE 10000

CMD ["sh", "-c", "uv run --no-sync uvicorn token_server:app --host 0.0.0.0 --port ${PORT:-10000} --proxy-headers --forwarded-allow-ips='*'"]
